  {"set": "kitchen", "state": {"sign": "BAKERY|OPEN"}, "text": "He looks me dead in the eye. My roommate buys a cake every weekend. I eat it. So I buy him an apology cake.", "sfx": "pop", "speaker": "co1", "bubble": {"text": "I EAT|HIS CAKE", "x": 340, "y": 540, "tail": 30},
