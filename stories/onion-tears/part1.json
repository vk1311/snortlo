  {"set": "closeup", "state": {"show": "text", "big": "IT'S A|TRAP", "bg1": "#F4F0DC", "bg2": "#B9A24A"}, "text": "Turns out the onion is booby trapped. Inside every cell, it keeps sulfur stuff and enzymes in separate rooms.", "sfx": "dundun"},
  {"set": "kitchen", "text": "When your knife breaks those cells open, the two finally meet. And they react instantly.", "sfx": "slap",
