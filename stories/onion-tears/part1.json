  {"set": "closeup", "state": {"show": "text", "big": "30 YEARS|NO TEARS", "bg1": "#E6F7EA", "bg2": "#3FA45B"}, "text": "And someone spent about thirty years cross breeding onions until they made one that barely makes you cry at all.", "sfx": "angelchoir"},
